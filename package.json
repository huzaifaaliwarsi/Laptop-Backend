{
  "name": "retail-repair-backend",
  "version": "1.0.0",
  "description": "Production REST API for Retail & Repair Management System",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch-path=src scripts/start-local.cjs",
    "start:local": "node scripts/start-local.cjs",
    "setup:local": "node scripts/start-local.cjs --setup-only",
    "test:branches": "node scripts/branch-integration.cjs && node scripts/branch-integration.cjs --legacy",
    "test:whatsapp": "node --test src/modules/whatsapp/auth-store.test.cjs src/modules/whatsapp/session.test.cjs",
    "migrate": "node seeds/developmentSeed.js",
    "migrate:cpanel": "node seeds/cpanel_migrate.js",
    "seed": "node seeds/seedRealisticData.js"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.20.2",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1"
  }
}
