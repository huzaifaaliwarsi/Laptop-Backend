# Backend Environment Configuration Template
PORT=5000
NODE_ENV=production

# PostgreSQL Database Configuration
DB_HOST=your-postgres-host.com
DB_PORT=5432
DB_NAME=retail_repair_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password
# Or full connection string if using Neon / Supabase / Railway / RDS:
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Authentication
JWT_SECRET=your-random-32-char-jwt-secret-key
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Frontend URL on Vercel)
CORS_ORIGIN=https://your-frontend-app.vercel.app
